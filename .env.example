# Copy this file to .env and add your key. Never commit .env.
#
# Get a free Groq API key here:  https://console.groq.com/keys
#   1. Sign up at https://console.groq.com  (free, no card needed)
#   2. Go to API Keys -> Create API Key
#   3. Paste it below
#
# One key covers both calls this app makes: Whisper transcription and the
# llama-3.3-70b-versatile feedback text.
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
WHISPER_MODEL=whisper-large-v3
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
DB_PATH=data/coach.db
AUDIO_DIR=data/audio

# --- Google sign-in ---------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: http://127.0.0.1:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Local convenience only: lets you sign in without Google. Never set in production.
ALLOW_DEV_LOGIN=true
